
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EmotiVision — AI Emotion Detector</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#fffaf7;
    color:#111827;
    overflow-x:hidden;
}

.navbar{
    height:88px;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 48px;
    background:rgba(255,255,255,.88);
    border-bottom:1px solid #eee8e5;
    z-index:20;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo-icon{
    width:48px;
    height:48px;
    border:2px solid #d33b91;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#d33b91;
    font-size:25px;
}

.logo-text strong{
    display:block;
    font-size:21px;
    color:#172033;
}

.logo-text span{
    display:block;
    font-size:13px;
    color:#777;
    margin-top:2px;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:38px;
}

.nav-links a{
    text-decoration:none;
    color:#222;
    font-size:15px;
    font-weight:500;
    padding:34px 0;
}

.nav-links a.active:after{
    content:"";
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    height:3px;
    border-radius:5px;
    background:linear-gradient(90deg,#a83de1,#ef6371);
}

.nav-actions{
    display:flex;
    align-items:center;
    gap:18px;
}

.signin{
    padding:13px 23px;
    border:1px solid #e5e5e5;
    background:white;
    border-radius:14px;
    font-weight:600;
}

.started{
    border:0;
    color:white;
    font-weight:700;
    padding:14px 25px;
    border-radius:14px;
    background:linear-gradient(100deg,#9636df,#ef626b);
    cursor:pointer;
}

.hero{
    min-height:755px;
    padding:72px 56px 0;
    overflow:hidden;
    background:
        radial-gradient(circle at 77% 45%,rgba(255,190,211,.42),transparent 32%),
        radial-gradient(circle at 100% 60%,rgba(255,213,225,.38),transparent 35%),
        linear-gradient(110deg,#fffaf5 0%,#fffaf8 45%,#fff1f5 100%);
}

.hero-inner{
    max-width:1430px;
    margin:auto;
    display:grid;
    grid-template-columns:46% 54%;
    align-items:center;
    min-height:670px;
}

.hero-copy{
    z-index:5;
    padding-bottom:80px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:#ffe7e2;
    color:#b63d45;
    padding:12px 19px;
    border-radius:25px;
    font-size:14px;
    font-weight:700;
    margin-bottom:28px;
}

.hero h1{
    font-size:70px;
    line-height:1.03;
    letter-spacing:-3px;
    max-width:650px;
    margin-bottom:25px;
    color:#111827;
}

.hero h1 span{
    background:linear-gradient(90deg,#c32b91,#f16469);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

.description{
    color:#555;
    font-size:19px;
    line-height:1.65;
    max-width:600px;
    margin-bottom:32px;
}

.buttons{
    display:flex;
    gap:18px;
    align-items:center;
}

.live-btn,
.upload-btn{
    height:62px;
    padding:0 28px;
    border-radius:14px;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:10px;
}

.live-btn{
    color:white;
    background:#131c2b;
    border:0;
}

.upload-btn{
    color:#151515;
    background:white;
    border:1px solid #ddd;
}

.trusted{
    margin-top:30px;
    display:flex;
    align-items:center;
    gap:12px;
    color:#555;
    font-size:14px;
}

.faces{
    display:flex;
}

.faces span{
    width:34px;
    height:34px;
    border-radius:50%;
    border:2px solid white;
    margin-left:-7px;
    background:linear-gradient(135deg,#555,#ddd);
}

.faces span:first-child{
    margin-left:0;
}

.hero-visual{
    height:650px;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    z-index:3;
}

.right-image{
    width:min(780px,100%);
    height:auto;
    max-height:650px;
    object-fit:contain;
    object-position:center bottom;
    transform:translateY(-250px);
    display:block;
    z-index:2;
}

.emotion-card{
    position:absolute;
    right:8px;
    top:175px;
    width:220px;
    min-height:350px;
    background:rgba(255,255,255,.94);
    border-radius:20px;
    box-shadow:0 20px 50px rgba(70,30,50,.12);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:26px;
    z-index:5;
    text-align:center;
}

.emotion-card small{
    font-size:14px;
    color:#777;
    margin-bottom:25px;
}

.emoji{
    font-size:66px;
    line-height:1;
    margin-bottom:18px;
}

.emotion-name{
    font-size:35px;
    font-weight:800;
    background:linear-gradient(90deg,#cf328e,#ee646c);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    margin-bottom:30px;
}

.confidence-label{
    font-size:14px;
    color:#777;
    margin-bottom:8px;
}

.confidence{
    font-size:25px;
    font-weight:800;
    color:#111827;
    margin-bottom:14px;
}

.progress{
    width:100%;
    height:8px;
    border-radius:10px;
    background:#eee;
    overflow:hidden;
}

.progress div{
    width:94.7%;
    height:100%;
    border-radius:10px;
    background:linear-gradient(90deg,#bd31cf,#ef6270,#f8a13c);
}

.stats{
    position:absolute;
    bottom:-101px;
    left:0;
    right:0;
    background:#fff;
    border-radius:32px 32px 0 0;
    box-shadow:0 -8px 30px rgba(0,0,0,.04);
    padding:30px 55px;
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:15px;
    z-index:10;
}

.stat{
    min-height:75px;
    display:flex;
    align-items:center;
    gap:15px;
    padding:0 18px;
    border-right:1px solid #eee;
}

.stat:last-child{
    border-right:0;
}

.stat-icon{
    width:50px;
    height:50px;
    border:1px solid #eee;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:24px;
    flex-shrink:0;
}

.stat strong{
    display:block;
    font-size:16px;
    color:#172033;
    line-height:1.35;
}

.stat span{
    display:block;
    font-size:14px;
    color:#222;
    margin-top:3px;
}

#fileInput{
    display:none;
}

#camera{
    display:none;
}

@media(max-width:1100px){
    .nav-links{
        gap:18px;
    }

    .hero h1{
        font-size:56px;
    }

    .hero-inner{
        grid-template-columns:48% 52%;
    }

    .emotion-card{
        right:-10px;
        transform:scale(.85);
        transform-origin:top right;
    }

    .stats{
        grid-template-columns:repeat(4,1fr);
    }

    .stat:nth-child(4){
        border-right:0;
    }
}

@media(max-width:800px){
    .navbar{
        padding:0 20px;
    }

    .nav-links{
        display:none;
    }

    .hero{
        padding:45px 25px 0;
    }

    .hero-inner{
        grid-template-columns:1fr;
    }

    .hero-copy{
        padding-bottom:20px;
    }

    .hero h1{
        font-size:48px;
        letter-spacing:-2px;
    }

    .hero-visual{
        height:520px;
    }

    .emotion-card{
        right:0;
        top:100px;
        transform:scale(.72);
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
        padding:25px;
    }
}

<style>
#cameraBox{
    position:fixed;
    inset:0;
    background:rgba(8,12,20,.78);
    z-index:99;
    align-items:center;
    justify-content:center;
}

#camera{
    width:720px;
    max-width:82vw;
    max-height:78vh;
    display:block;
    border-radius:24px;
    border:4px solid white;
    box-shadow:0 25px 80px rgba(0,0,0,.35);
    background:#111;
}

#liveEmotionCard{
    position:fixed;
    right:45px;
    top:50%;
    transform:translateY(-50%);
    width:245px;
    min-height:300px;
    background:rgba(255,255,255,.97);
    border-radius:22px;
    padding:28px 24px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.3);
    z-index:101;
}

#liveEmotionCard .live-title{
    font-size:14px;
    color:#777;
    margin-bottom:22px;
}

#liveEmoji{
    font-size:65px;
    margin-bottom:12px;
}

#liveEmotion{
    font-size:32px;
    font-weight:800;
    background:linear-gradient(90deg,#c52d91,#ef646b);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    margin-bottom:25px;
}

#liveConfidenceLabel{
    color:#777;
    font-size:14px;
    margin-bottom:6px;
}

#liveConfidence{
    font-size:25px;
    font-weight:800;
    margin-bottom:14px;
}

#liveProgress{
    width:100%;
    height:8px;
    background:#eee;
    border-radius:10px;
    overflow:hidden;
}

#liveProgressBar{
    width:0%;
    height:100%;
    border-radius:10px;
    background:linear-gradient(90deg,#bd31cf,#ef6270,#f8a13c);
    transition:width .3s ease;
}

#cameraStatus{
    position:fixed;
    left:50%;
    bottom:28px;
    transform:translateX(-50%);
    color:white;
    background:rgba(0,0,0,.65);
    padding:10px 18px;
    border-radius:20px;
    font-size:14px;
    z-index:102;
}

#closeCameraBtn{
    position:fixed;
    right:35px;
    top:30px;
    border:0;
    background:white;
    color:#111;
    padding:12px 20px;
    border-radius:12px;
    font-weight:700;
    cursor:pointer;
    z-index:103;
}
</style>

</style>

<style>
.camera-layout {
    width: min(1200px, 94vw);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
}

.camera-preview {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.camera-preview #camera {
    width: min(680px, 58vw);
    max-height: 78vh;
    object-fit: cover;
    border-radius: 18px;
    background: #000;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
}

#liveEmotionCard {
    width: 320px;
    max-height: 78vh;
    overflow-y: auto;
    padding: 24px;
    border-radius: 20px;
    background: rgba(20,25,38,.96);
    color: white;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
    border: 1px solid rgba(255,255,255,.12);
}

.live-title {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 18px;
}

.face-status {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #55e39a;
    font-size: 13px;
    margin-bottom: 20px;
}

.status-dot {
    width: 9px;
    height: 9px;
    background: #55e39a;
    border-radius: 50%;
    box-shadow: 0 0 12px #55e39a;
}

.detected-emotion {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 15px;
}

.emotion-emoji {
    font-size: 46px;
}

.emotion-label {
    color: #9da6b8;
    font-size: 12px;
}

#liveEmotion {
    font-size: 23px;
    font-weight: 800;
    margin-top: 3px;
}

.live-emotion-confidence {
    color: #cbd2df;
    font-size: 14px;
    margin-bottom: 20px;
}

.emotion-bars > div:not(.bar) {
    display: flex;
    justify-content: space-between;
    color: #d9deea;
    font-size: 12px;
    margin-top: 10px;
}

.bar {
    height: 7px;
    background: #303747;
    border-radius: 10px;
    overflow: hidden;
}

.bar i {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg,#7c5cff,#38d9ff);
    transition: width .3s ease;
}

@media (max-width: 900px) {
    .camera-layout {
        flex-direction: column;
        overflow-y: auto;
        padding: 80px 15px 30px;
    }

    .camera-preview #camera {
        width: 90vw;
    }

    #liveEmotionCard {
        width: min(90vw, 500px);
    }
}
</style>

</head>

<body>

